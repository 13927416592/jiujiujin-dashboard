 docs/alipay-scheduler.md | 2 +-
 scripts/alipay-daily.sh  | 3 +--
 2 files changed, 2 insertions(+), 3 deletions(-)

diff --git a/docs/alipay-scheduler.md b/docs/alipay-scheduler.md
index 407d7fe..36fe074 100644
--- a/docs/alipay-scheduler.md
+++ b/docs/alipay-scheduler.md
@@ -108,13 +108,13 @@ launchctl load ~/Library/LaunchAgents/com.jiujiujin.alipay-daily.plist
 cat > ~/jiujiujin-dashboard/.alipay-env <<'EOF'
 export ALIPAY_USERNAME="你的支付宝账号"
 export ALIPAY_PASSWORD="你的登录密码"
-export FEISHU_WEBHOOK_URL="你的飞书机器人 webhook（可选）"
 EOF
 chmod 600 ~/jiujiujin-dashboard/.alipay-env
 ```
 
 `alipay-daily.sh` 启动时会自动 `source` 该文件注入环境变量（launchd 不会读取 `.zshrc`，必须走这里）。
 
+- 飞书失败告警复用已有的「运营助手」应用（`scripts/feishu-alert.sh` 读取项目根 `.env` 里的 `FEISHU_APP_ID/SECRET/USER_ID`），**无需在 `.alipay-env` 里再配 webhook**。
 - 交互终端手动跑时，也可以直接 `export ALIPAY_USERNAME=...` 后运行。
 - 账号密码**只从环境变量读取**，代码中不硬编码。
 
diff --git a/scripts/alipay-daily.sh b/scripts/alipay-daily.sh
index 02ee0e4..1c3179b 100644
--- a/scripts/alipay-daily.sh
+++ b/scripts/alipay-daily.sh
@@ -20,10 +20,9 @@ export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PAT
 unset HEADLESS
 
 # 加载账密等环境变量（launchd 不读 .zshrc，统一从该文件注入；文件不入库、权限 600）。
-# 内容示例：
+# 内容只需支付宝账密（飞书告警走 .env，由 feishu-alert.sh 自行加载）：
 #   export ALIPAY_USERNAME="你的账号"
 #   export ALIPAY_PASSWORD="你的密码"
-#   export FEISHU_WEBHOOK_URL="你的飞书机器人 webhook"
 if [ -f "$PROJECT_DIR/.alipay-env" ]; then
     set -a; . "$PROJECT_DIR/.alipay-env"; set +a
 fi
