+            '[class*="checkbox"]:not([class*="checked"])',
+            '[class*="agree"] [class*="check"]',
+          ].join(', ')
+        )
+        .first();
+      if (await agree.isVisible({ timeout: 600 }).catch(() => false)) {
+        await agree.click({ timeout: 2000 }).catch(() => undefined);
+      }
+
+      // 5) 点登录按钮
